(copy_files ../src/raw.ml)

(test
 (name test_iocp)
 (modules test_iocp raw)
 (modes byte byte_complete exe)
 (deps ../src/dlliocp_stubs.dll)
 (action
  (setenv CAML_LD_LIBRARY_PATH "../src;%{env:CAML_LD_LIBRARY_PATH=}"
   (run %{test})))
 (libraries iocp alcotest)
 (enabled_if (= %{os_type} "Win32")))

(rule
 (alias runtest)
 (enabled_if (= %{os_type} "Win32"))
 (action (run ./test_iocp.bc.exe)))
